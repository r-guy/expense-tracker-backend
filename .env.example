# Copy this file to .env and fill in your own values.

EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here
EXCHANGE_RATE_API_BASE=https://v6.exchangerate-api.com/v6
CACHE_TTL_SECONDS=3600
UPSTREAM_TIMEOUT_SECONDS=10
PORT=8000

# --- Neon (written by `neon deploy`, do not hand-edit) ---
# DATABASE_URL=postgresql://...
# DATABASE_URL_UNPOOLED=postgresql://...
# NEON_AUTH_BASE_URL=https://<auth-host>/<db>/auth
# NEON_AUTH_JWKS_URL=https://<auth-host>/<db>/auth/.well-known/jwks.json
# NEON_BRANCH=production
# NEON_BRANCH_ID=br-...
